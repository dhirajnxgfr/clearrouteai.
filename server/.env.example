# ClearRoute AI Backend Environment Configuration
# ================================================

# Supabase PostgreSQL pooled connection string (port 6543, add ?pgbouncer=true&connection_limit=1)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase PostgreSQL direct connection string (port 5432), used for Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Auth Project URL and Public Anon Key
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase JWT Secret (optional, used for local jose verification)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# Server Port
PORT=8080

# Allowed CORS origins (comma-separated list, or * for development)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://clearroute-ai.vercel.app"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"
